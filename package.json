{
  "name": "agent-intent",
  "version": "0.2.0",
  "private": true,
  "description": "Gherkin specifications, BDD test lineage, and individual specification acceptance",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "bin": {
    "agent-intent": "runtime/cli.cjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "start": "node runtime/cli.cjs serve",
    "intent": "node runtime/cli.cjs",
    "test:acceptance": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:lineage": "node --enable-source-maps --import tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./runtime/lineage-reporter.cjs --test-reporter-destination=test-lineage.html tests/*.test.ts",
    "test": "npm run typecheck && npm run build:check && npm run test:acceptance && npm run test:unit",
    "stop": "node --import tsx scripts/stop.ts",
    "pages:prepare": "node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.10",
    "@cucumber/gherkin": "42.0.1",
    "highlight.js": "11.12.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
