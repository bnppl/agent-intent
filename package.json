{
  "name": "agent-intent",
  "version": "0.2.0",
  "private": true,
  "description": "Gherkin specifications, BDD test lineage, and individual specification acceptance",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "bin": {
    "agent-intent": "runtime/cli.cjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "start": "node runtime/cli.cjs start",
    "intent": "node runtime/cli.cjs",
    "test:acceptance": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:lineage": "node scripts/test-lineage.mjs",
    "test": "npm run test:acceptance && npm run test:unit",
    "stop": "node runtime/cli.cjs stop",
    "pages:prepare": "node scripts/prepare-pages.mjs",
    "serve": "node runtime/cli.cjs serve",
    "check:static": "npm run typecheck && npm run build:check"
  },
  "dependencies": {
    "@babel/parser": "8.0.10",
    "@cucumber/gherkin": "42.0.1",
    "highlight.js": "11.12.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "playwright": "^1.65.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "files": [
    "runtime/*.cjs",
    ".agents/skills/agent-intent",
    ".agents/skills/intent-spec",
    ".agents/skills/intent-implement",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bnppl/intent-dd.git"
  }
}
