  "narrative": {
    "northStar": "The Outline Workspace",
    "overview": "Agent Intent uses a quiet, flat developer-report language: evergreen navigation, a pale cream canvas, readable report prose and compact technical evidence. Context remains visible while the detail stage follows the reviewer into the next level.\n\nThe report treats test outcomes, specification changes and human acceptance as separate information. Visual hierarchy supports inspection without implying that a passing test is an accepted specification.",
    "keyCharacteristics": [
      "Persistent outline and shared breadcrumb navigation.",
      "One selected detail level at a time.",
      "Flat surfaces with restrained borders and tonal states.",
      "System UI prose paired with monospace source and evidence."
    ],
    "rules": [
      {
        "name": "The Context Rule",
        "body": "Keep the outline and shared breadcrumb bar available while the selected detail owns the stage.",
        "section": "layout"
      },
      {
        "name": "The Evidence Rule",
        "body": "Keep execution results visually and semantically separate from specification changes and human acceptance.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders, whitespace and tonal fills to distinguish surfaces; the report does not use drop shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve current location in the outline and breadcrumb bar.",
      "Do retain original evidence nodes, disclosure state, focus and scroll when navigating back.",
      "Do use monospace for source, logs, paths and technical identifiers.",
      "Do retain readable labels alongside result and change colors."
    ],
    "donts": [
      "Don't equate passing execution with human acceptance.",
      "Don't turn deeper inspection into a stack of simultaneously visible detail panels.",
      "Don't add ornamental shadows to the flat report surfaces."
    ]
  }
}
